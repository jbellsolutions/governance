      "method": "POST",
      "path": "/api/companies/{companyId}/agents",
      "params": [
        {
          "name": "companyId",
          "type": "string",
          "location": "path",
          "description": "Company id",
          "required": true
        },
        {
          "name": "adapter-config-cwd",
          "wire_name": "adapterConfig.cwd",
          "type": "string",
          "location": "body",
          "description": "Cwd"
        },
        {
          "name": "adapter-config-env",
          "wire_name": "adapterConfig.env",
          "type": "object",
          "location": "body",
          "description": "Env"
        },
        {
          "name": "adapter-config-model",
          "wire_name": "adapterConfig.model",
          "type": "string",
          "location": "body",
          "description": "Model"
        },
        {
          "name": "adapterType",
          "type": "string",
          "location": "body",
          "description": "Adapter type",
          "required": true
        },
        {
          "name": "budgetMonthlyCents",
          "type": "int",
          "location": "body",
          "description": "Budget monthly cents"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name",
          "required": true
        },
        {
          "name": "reportsTo",
          "type": "string",
          "location": "body",
