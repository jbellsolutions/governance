{
  "api_name": "gov",
  "base_url": "https://137-184-151-136.sslip.io",
  "description": "The verified subset of the Paperclip board API used to spin up and manage teams of AI agents — whole businesses (companies) or departments (agents inside a company). Hand-authored from a live board (Paperclip 2026.529.0); Paperclip does not expose its own OpenAPI document.\nPath rule: collection ops (create/list) are nested under /api/companies/{companyId}/...; single-item ops (get/update/delete) are top-level /api/{resource}/{id}.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "bearer_token",
    "header": "Authorization",
    "env_vars": [
      "GOV_BOARD_KEY"
    ],
    "env_var_specs": [
      {
        "name": "GOV_BOARD_KEY",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "agents_delete",
      "description": "Delete an agent (managers with reports may 500 — set status=terminated instead). Required: agentId. Destructive.",
      "method": "DELETE",
      "path": "/api/agents/{agentId}",
      "params": [
        {
          "name": "agentId",
          "type": "string",
          "location": "path",
          "description": "Agent id",
          "required": true
        }
      ]
    },
    {
      "name": "agents_get",
      "description": "Read an agent (incl. stats). Required: agentId.",
      "method": "GET",
      "path": "/api/agents/{agentId}",
      "params": [
        {
          "name": "agentId",
          "type": "string",
          "location": "path",
          "description": "Agent id",
          "required": true
        }
      ]
    },
    {
      "name": "agents_update",
      "description": "Update an agent (status, budget, adapter, reporting line). Required: agentId. Optional: adapterConfig, adapterType, budgetMonthlyCents (plus 3 more). Partial update.",
      "method": "PATCH",
      "path": "/api/agents/{agentId}",
      "params": [
        {
          "name": "agentId",
          "type": "string",
          "location": "path",
          "description": "Agent id",
          "required": true
        },
        {
          "name": "adapter-config-cwd",
          "wire_name": "adapterConfig.cwd",
          "type": "string",
          "location": "body",
          "description": "Cwd"
        },
        {
          "name": "adapter-config-env",
          "wire_name": "adapterConfig.env",
          "type": "object",
          "location": "body",
          "description": "Env"
        },
        {
          "name": "adapter-config-model",
          "wire_name": "adapterConfig.model",
          "type": "string",
          "location": "body",
          "description": "Model"
        },
        {
          "name": "adapterType",
          "type": "string",
          "location": "body",
          "description": "Adapter type"
        },
        {
          "name": "budgetMonthlyCents",
          "type": "int",
          "location": "body",
          "description": "Budget monthly cents"
        },
        {
          "name": "reportsTo",
          "type": "string",
          "location": "body",
          "description": "Reports to"
        },
        {
          "name": "status",
          "type": "string",
          "location": "body",
          "description": "Status"
        },
        {
          "name": "title",
          "type": "string",
          "location": "body",
          "description": "Title"
        }
      ]
    },
    {
      "name": "companies_create-company",
      "description": "Create a company (a new business). Required: name. Optional: description, metadata.",
      "method": "POST",
      "path": "/api/companies",
      "params": [
        {
          "name": "description",
          "type": "string",
          "location": "body",
          "description": "Description"
        },
        {
          "name": "metadata",
          "type": "object",
          "location": "body",
          "description": "Metadata"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name",
          "required": true
        }
      ]
    },
    {
      "name": "companies_get-company",
      "description": "Read a company (incl. budget/spend). Required: companyId.",
