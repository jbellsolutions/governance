      "method": "GET",
      "path": "/api/companies",
      "params": []
    },
    {
      "name": "companies_update-company",
      "description": "Update a company (rename, budget, archive). Required: companyId. Optional: budgetMonthlyCents, description, name (plus 1 more). Partial update.",
      "method": "PATCH",
      "path": "/api/companies/{companyId}",
      "params": [
        {
          "name": "companyId",
          "type": "string",
          "location": "path",
          "description": "Company id",
          "required": true
        },
        {
          "name": "budgetMonthlyCents",
          "type": "int",
          "location": "body",
          "description": "Budget monthly cents"
        },
        {
          "name": "description",
          "type": "string",
          "location": "body",
          "description": "Description"
        },
        {
          "name": "name",
          "type": "string",
          "location": "body",
          "description": "Name"
        },
        {
          "name": "status",
          "type": "string",
          "location": "body",
          "description": "Status"
        }
      ]
    },
