    {
      "name": "companies_imports_apply",
      "description": "Import a team/business package (github subdir tree URL, or inline files) as a new or existing company. Required: companyId, source, target. Optional: adapterOverrides, collisionStrategy, include.",
      "method": "POST",
      "path": "/api/companies/{companyId}/imports/apply",
      "params": [
        {
          "name": "companyId",
          "type": "string",
          "location": "path",
          "description": "Company id",
          "required": true
        },
        {
          "name": "adapterOverrides",
          "type": "object",
          "location": "body",
          "description": "Keyed by agent slug. Safe imports reject the 'process' adapter — force opencode_local here (requires adapterConfig.model)."
        },
        {
          "name": "collisionStrategy",
          "type": "string",
          "location": "body",
          "description": "'replace' is NOT allowed on safe (board-key) imports"
        },
        {
          "name": "include-agents",
          "wire_name": "include.agents",
          "type": "bool",
          "location": "body",
          "description": "Agents"
        },
        {
          "name": "include-company",
          "wire_name": "include.company",
          "type": "bool",
          "location": "body",
          "description": "Company"
        },
        {
          "name": "include-issues",
          "wire_name": "include.issues",
          "type": "bool",
          "location": "body",
          "description": "Issues"
        },
        {
          "name": "include-projects",
          "wire_name": "include.projects",
          "type": "bool",
          "location": "body",
          "description": "Projects"
        },
        {
          "name": "include-skills",
          "wire_name": "include.skills",
          "type": "bool",
          "location": "body",
          "description": "Skills"
        },
        {
          "name": "source",
          "type": "string",
          "location": "body",
          "description": "Source",
          "required": true
        },
        {
          "name": "target",
          "type": "string",
          "location": "body",
          "description": "Target",
          "required": true
        }
      ]
    },
