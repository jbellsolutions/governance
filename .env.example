# ── Required ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── Composio (real tools: email / calendar / CRM / Slack / Notion) ──
COMPOSIO_API_KEY=...
COMPOSIO_MAX_CONCURRENT=10

# ── Integrations sidecar (the agents' tools) ────────
INTEGRATIONS_URL=http://localhost:8080
SPECIALIST_MODEL=deepseek/deepseek-chat-v4

# ── Paperclip board (the panel / control plane) ─────
PAPERCLIP_API_URL=http://localhost:3000
PAPERCLIP_API_KEY=                     # board key (for archivist + slack relay)

# ── Paperclip process-adapter worker (OpenRouter path) ──
AGENT_MODEL=anthropic/claude-sonnet-4-6
WORKER_SESSION_TURNS=12                 # per-issue session memory depth

# ── Backups: Obsidian + Notion (every action & thought) ──
OBSIDIAN_VAULT_PATH=                    # e.g. /opt/governance/vault  (empty = off)
NOTION_API_KEY=                         # direct Notion API token (optional)
NOTION_PARENT_PAGE_ID=                  # parent page id for backup pages (optional)
ARCHIVE_POLL_SECONDS=60

# ── Slack (talk to your CEO from Slack) ─────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_OWNER_CHANNEL=#governance
SLACK_RELAY_PORT=3001
