# ── Required ────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Slack (for bidirectional integration) ───────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# ── Composio (for 10,000+ integrations) ─────────────
COMPOSIO_API_KEY=...
COMPOSIO_MAX_CONCURRENT=10

# ── Integrations sidecar (agents' tools) ────────────
# The business skills call this URL. Default = the --specialists service.
INTEGRATIONS_URL=http://localhost:8080
SPECIALIST_MODEL=deepseek/deepseek-chat-v4

# ── Paperclip process-adapter worker (path B only) ──
# Model used by paperclip_worker.py when agents run via the `process` adapter.
AGENT_MODEL=anthropic/claude-sonnet-4-6

# ── Model routing (all via OpenRouter) ──────────────
EXPERT_MODEL=deepseek/deepseek-chat-v4
MODERATOR_MODEL=anthropic/claude-opus-4-8
EXEC_MODEL=anthropic/claude-sonnet-4-6
SALES_MODEL=moonshotai/kimi-2
MARKETING_MODEL=moonshotai/kimi-2

# ── Paperclip ────────────────────────────────────────
PAPERCLIP_URL=http://localhost:3000

# ── OpenRouter base URL (do not change) ─────────────
OPENAI_BASE_URL=https://openrouter.ai/api/v1
